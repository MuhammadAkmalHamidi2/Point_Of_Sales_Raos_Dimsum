const { StockOpname, StockOpnameDetail, Inventory, sequelize } = require('../models');

// GET Inventori per Outlet (untuk Form Stock Opname)
exports.getInventoryForOpname = async (req, res) => {
  try {
    const outletId = req.user.outletId; // Wajib dari JWT
    const items = await Inventory.findAll({
      where: { outletId, aktif: true },
      order: [['nama', 'ASC']],
    });

    return res.json({ success: true, data: items });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// SUBMIT Stock Opname
exports.submitOpname = async (req, res) => {
  const transaction = await sequelize.transaction();
  try {
    const outletId = req.user.outletId;
    const userId = req.user.id;
    const { tanggal, catatan, items } = req.body; 
    // items: [{ inventoryId: 1, stokSistem: 97, stokFisik: 96, selisih: -1 }, ...]

    const opname = await StockOpname.create(
      { outletId, tanggal, catatan, createdBy: userId },
      { transaction }
    );

    const details = items.map((item) => ({
      stockOpnameId: opname.id,
      inventoryId: item.inventoryId,
      stokSistem: item.stokSistem,
      stokFisik: item.stokFisik,
      selisih: item.selisih,
    }));

    await StockOpnameDetail.bulkCreate(details, { transaction });

    // SINKRONISASI STOK: Update stok fisik ke tabel Inventory
    for (const item of items) {
      await Inventory.update(
        { stok: item.stokFisik },
        { where: { id: item.inventoryId, outletId }, transaction }
      );
    }

    await transaction.commit();
    return res.json({ success: true, message: 'Stock Opname berhasil disimpan dan stok disesuaikan' });
  } catch (error) {
    await transaction.rollback();
    return res.status(500).json({ success: false, message: error.message });
  }
};